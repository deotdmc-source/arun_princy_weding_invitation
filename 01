<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wedding Invitation - Arun & Princy</title>
    <!-- Google Fonts for Luxury Aesthetic -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-color: #121212;
            --card-bg: #1a1a1a;
            --ivory: #FDFBF7;
            --ivory-dim: #E5DEC9;
            --gold-accent: #D4AF37;
            --text-muted: #8A8A8A;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--ivory);
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* Ambient Background Grid Pattern */
        .bg-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(180deg, rgba(18,18,18,0.2) 0%, rgba(26,26,26,0.8) 100%);
            background-image: radial-gradient(rgba(229, 222, 201, 0.03) 1px, transparent 0);
            background-size: 24px 24px;
            z-index: -1;
            pointer-events: none;
        }

        /* Elegant Music Icon Control */
        .music-control {
            position: fixed;
            top: 20px;
            right: 20px;
            width: 45px;
            height: 45px;
            background: rgba(26, 26, 26, 0.85);
            border: 1px solid var(--ivory-dim);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 1000;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            transition: transform 0.3s ease;
        }

        .music-control.playing {
            animation: pulse-border 2s infinite;
        }

        .music-control svg {
            width: 20px;
            height: 20px;
            fill: var(--ivory);
            transition: fill 0.3s ease;
        }

        /* Open Cover Overlay Animation */
        #cover-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: var(--bg-color);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: transform 1s cubic-bezier(0.77, 0, 0.175, 1);
            border: 15px solid var(--card-bg);
        }

        .cover-content {
            text-align: center;
            padding: 20px;
        }

        .cover-title {
            font-family: 'Cinzel', serif;
            font-size: 2.2rem;
            letter-spacing: 4px;
            color: var(--ivory);
            margin-bottom: 10px;
        }

        .cover-subtitle {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 1.2rem;
            color: var(--gold-accent);
            margin-bottom: 40px;
        }

        .enter-btn {
            font-family: 'Montserrat', sans-serif;
            background: transparent;
            border: 1px solid var(--ivory-dim);
            color: var(--ivory);
            padding: 12px 30px;
            font-size: 0.9rem;
            letter-spacing: 2px;
            cursor: pointer;
            text-transform: uppercase;
            transition: all 0.4s ease;
        }

        .enter-btn:hover {
            background: var(--ivory);
            color: var(--bg-color);
        }

        /* Main Container setup */
        .wrapper {
            max-width: 480px;
            margin: 0 auto;
            padding: 60px 20px 40px 20px;
            position: relative;
        }

        header {
            text-align: center;
            margin-bottom: 50px;
        }

        .badge {
            font-size: 0.75rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--gold-accent);
            margin-bottom: 15px;
            display: inline-block;
        }

        .couple-names {
            font-family: 'Playfair Display', serif;
            font-size: 2.8rem;
            font-weight: 400;
            line-height: 1.2;
            margin: 20px 0;
            color: var(--ivory);
        }

        .couple-names span {
            display: block;
            font-size: 1.5rem;
            font-family: 'Cinzel', serif;
            color: var(--text-muted);
            margin: 5px 0;
        }

        /* Card Section Styling */
        .card {
            background-color: var(--card-bg);
            border: 1px solid rgba(229, 222, 201, 0.1);
            border-radius: 4px;
            padding: 35px 25px;
            margin-bottom: 35px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            text-align: center;
        }

        .card-title {
            font-family: 'Cinzel', serif;
            font-size: 1.2rem;
            letter-spacing: 2px;
            margin-bottom: 25px;
            color: var(--ivory-dim);
        }

        .message-text {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 1.05rem;
            line-height: 1.8;
            color: var(--ivory-dim);
        }

        /* Canvas Scratch Mechanics */
        .scratch-container {
            position: relative;
            width: 100%;
            max-width: 320px;
            height: 130px;
            margin: 0 auto 20px auto;
            background: #111;
            border-radius: 4px;
            overflow: hidden;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
        }

        .scratch-reveal-content {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 1;
        }

        .revealed-date {
            font-family: 'Cinzel', serif;
            font-size: 1.15rem;
            font-weight: bold;
            color: var(--gold-accent);
            letter-spacing: 1px;
        }

        .revealed-time {
            font-size: 0.85rem;
            color: var(--ivory-dim);
            margin-top: 5px;
        }

        #scratch-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 2;
            cursor: pointer;
            touch-action: none;
        }

        /* Custom Action Buttons */
        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: 1px solid var(--gold-accent);
            color: var(--gold-accent);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            padding: 12px 24px;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            margin-top: 10px;
            width: 100%;
        }

        .action-btn:hover, .action-btn:active {
            background: var(--gold-accent);
            color: #000;
        }

        /* Countdown Elements */
        .countdown-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .countdown-item {
            background: rgba(0, 0, 0, 0.3);
            padding: 15px 5px;
            border-radius: 4px;
            border: 1px solid rgba(255,255,255,0.03);
        }

        .countdown-val {
            font-family: 'Cinzel', serif;
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--ivory);
        }

        .countdown-lbl {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            margin-top: 5px;
        }

        /* Venue layout structure */
        .venue-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
            color: var(--ivory);
            margin-bottom: 8px;
        }

        .venue-details {
            font-size: 0.88rem;
            line-height: 1.6;
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        /* Modernized Form Controls */
        .love-symbol {
            font-size: 1.8rem;
            color: var(--gold-accent);
            margin: 10px 0 20px 0;
            animation: beat 1.5s infinite alternate;
        }

        .form-group {
            text-align: left;
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--ivory-dim);
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(229, 222, 201, 0.2);
            padding: 12px;
            color: var(--ivory);
            font-family: 'Montserrat', sans-serif;
